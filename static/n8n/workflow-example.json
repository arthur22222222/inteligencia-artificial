        -520,
        0
      ],
      "webhookId": "7d7b3f5e-1c2d-4c3b-8a9e-2f2a6b1d0c10",
      "notes": "Copie a Production URL deste nó e cole em Integrações na Nexa AI."
    },
    {
      "parameters": {
        "jsCode": "// Normaliza o payload enviado pela Nexa AI.\nconst raw = $json.body ?? $json;\nconst event = String(raw.event || \"unknown\");\nconst user = raw.user || {};\nconst appointment = raw.appointment || null;\nconst previous = appointment?.previous || null;\n\nif (raw.source && raw.source !== \"nexa-ai\") {\n  throw new Error(\"Evento recusado: origem diferente de nexa-ai.\");\n}\n\nconst when = appointment\n  ? `${appointment.date || \"?\"} às ${appointment.time || \"?\"}`\n  : \"sem horário\";\nconst previousWhen = previous ? `${previous.date || \"?\"} às ${previous.time || \"?\"}` : null;\n\nconst service = appointment?.service?.name || \"sessão\";\nconst label = {\n  \"appointment.created\": `Novo agendamento: ${user.name || user.email} — ${service} em ${when}`,\n  \"appointment.rescheduled\": previousWhen\n    ? `Agendamento reagendado: ${user.name || user.email} — ${service} de ${previousWhen} para ${when}`\n    : `Agendamento reagendado: ${user.name || user.email} — ${service} agora em ${when}`,\n  \"appointment.cancelled\": `Agendamento cancelado: ${user.name || user.email} — ${service} em ${when}`,\n  \"user.registered\": `Novo cadastro na Nexa: ${user.name || user.email}`,\n  \"integration.test\": \"Teste de conexão recebido com sucesso\",\n}[event] || `Evento recebido: ${event}`;\n\nreturn [{\n  json: {\n    event,\n    label,\n    user,\n    appointment,\n    previous,\n    received_at: new Date().toISOString(),\n    source: \"nexa-ai\",\n  },\n}];"
      },
